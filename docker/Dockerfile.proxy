# ==============================================================================
# Nginx Reverse Proxy with AI-WAF subrequest enforcement
# Performs rate limiting, subrequest authorization, and HTTP 403 blocking
# ==============================================================================
FROM nginx:1.27-alpine

# Copy custom Nginx configuration and error pages
COPY proxy/nginx.conf /etc/nginx/nginx.conf
COPY proxy/custom_403.html /etc/nginx/html/custom_403.html

EXPOSE 80 8080

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:80/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
